# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Embedding: Cohere Embed API v2 (https://api.cohere.com/v2/embed)
# Lấy key tại https://dashboard.cohere.com -> API Keys. KHÔNG điền key thật vào file này.
COHERE_API_KEY=
EMBEDDING_MODEL=embed-v4.0
# Chỉ dùng cho embed-v4.0 / embed-v5.0-*; để trống với embed-multilingual-v3.0 (cố định 1024 chiều)
EMBEDDING_DIMENSION=1536
